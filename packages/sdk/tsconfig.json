{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2020",
        "moduleResolution": "node",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": true,
        "downlevelIteration": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "noImplicitAny": false
    },
    "include": ["src/**/*"]
}
