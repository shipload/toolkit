{
    "name": "@shipload/toolkit",
    "private": true,
    "version": "0.0.0",
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@changesets/cli": "^2.31.0",
        "@types/pixelmatch": "^5.2.6",
        "@types/pngjs": "^6.0.5",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "check": "biome check . && bun --filter '*' run check",
        "test": "bun --filter '*' test",
        "build": "bun --filter '*' run build",
        "format": "biome check . --write"
    }
}
